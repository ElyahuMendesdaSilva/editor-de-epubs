{
  "name": "editor-de-epubs",
  "productName": "Editor de eBook",
  "version": "0.0.1",
  "description": "Um editor minimalista para transformar algumas novels em epub",
  "license": "SEE LICENSE IN LICENSE",
  "author": "elyahumendes",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.elyahumendes.editordeepubs",
    "productName": "Editor de eBook",
    "files": [
      "**/*",
      "!**/*.md",
      "!.gitignore"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "maintainer": "elyahumendes <elyahumendes@users.noreply.github.com>"
    }
  }
}
