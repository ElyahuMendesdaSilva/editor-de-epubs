{
  "name": "editor-de-epubs",
  "productName": "Editor de eBook",
  "version": "0.0.5",
  "description": "Um editor minimalista para transformar algumas novels em epub",
  "license": "SEE LICENSE IN LICENSE",
  "author": "elyahumendes",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElyahuMendesdaSilva/editor-de-epubs.git"
  },
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/check-syntax.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "release": "electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.elyahumendes.editordeepubs",
    "productName": "Editor de eBook",
    "files": [
      "**/*",
      "!**/*.md",
      "!.gitignore"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "ElyahuMendesdaSilva",
      "repo": "editor-de-epubs",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Office",
      "maintainer": "elyahumendes <elyahumendes@users.noreply.github.com>"
    }
  }
}
